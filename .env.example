# ═══════════════════════════════════════════════════════════════════════════
#  Otohom agentic-commerce agent — environment template
#  Copy to .env and fill in real values:   cp .env.example .env
#  NEVER commit .env (it is gitignored). Every value below is a placeholder.
# ═══════════════════════════════════════════════════════════════════════════

APP_ENV=development                 # set to "production" to hard-fail on placeholder secrets

# ── LLM (OpenRouter, OpenAI-compatible) ────────────────────────────────────
# Avoid ":free" model variants here. They are pooled and queued, which showed up as 15-40s
# turns and intermittent errors; a paid Flash key costs cents at this volume.
OPENAI_API_BASE=https://openrouter.ai/api/v1
OPENAI_API_KEY=
DEFAULT_MODEL=google/gemini-2.5-flash            # the customer-facing sales reply
FAST_MODEL=google/gemini-2.5-flash-lite          # triage, RAG condensation, memory extraction
MODEL_FALLBACKS=google/gemini-2.5-flash-lite,openai/gpt-4o-mini   # tried in order if the primary fails outright
LLM_TIMEOUT_SECONDS=40                           # ceiling for a whole node (may span 3 output strategies)
LLM_REQUEST_TIMEOUT_SECONDS=12                   # ceiling for ONE http call; must stay well below the above
LLM_MAX_OUTPUT_TOKENS=2048                       # replies are small JSON; asking for the full window inflates cost pre-auth
MAX_RETRIES=2                                    # retries per node before the graceful in-chat fallback

# ── Meta / WhatsApp Cloud API ──────────────────────────────────────────────
META_APP_SECRET=your_app_secret
WHATSAPP_API_TOKEN=your_whatsapp_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_id
WHATSAPP_VERIFY_TOKEN=your_verify_token

# ── Infrastructure ────────────────────────────────────────────────────────
# Inside docker-compose the hosts are the service names (postgres / redis), and
# docker-compose.yml OVERRIDES the two URLs below with in-network ones — so these values
# only matter when you run uvicorn/taskiq directly on the host.
DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/otohom
REDIS_URL=redis://localhost:6379/0
TASKIQ_QUEUE_NAME=salesforge_wa_queue

# Credentials the postgres CONTAINER is created with (docker-compose reads these).
# They are also what the overridden in-network DATABASE_URL is built from, so changing one
# changes both. Defaults to otohom/otohom/otohom if you leave them out entirely.
POSTGRES_USER=otohom
POSTGRES_PASSWORD=otohom
POSTGRES_DB=otohom

# ── Razorpay (TEST MODE) — the money action ────────────────────────────────
# Dashboard -> Settings -> API Keys -> Generate Test Key.
# Leave empty to run the agent with checkout disabled (it degrades gracefully).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard -> Settings -> Webhooks -> Add New Webhook. Set the same secret here.
# Empty = inbound Razorpay webhooks are rejected (fail-closed).
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_API_BASE=https://api.razorpay.com/v1

# ── Money bounds (code clamps every amount to these; the LLM cannot widen them) ──
AGENT_FULL_AUTONOMY=true            # false restores the client's pricing->human handoff
MAX_DISCOUNT_PCT=12.0               # hard ceiling on any agent-applied discount
RAZORPAY_MIN_AMOUNT=1.0
RAZORPAY_MAX_AMOUNT=500000.0        # per-order cap; above this no link is minted
MAX_LINE_QTY=20
MAX_PAYMENT_FAILURES=3              # consecutive declines before the critical escalation valve trips

# ── Observability (Langfuse) — optional; unset = tracing is a no-op ────────
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ── Semantic memory (mem0) — optional ─────────────────────────────────────
MEM0_ENABLED=false
MEM0_SEARCH_LIMIT=5
# mem0 gets its own small embedder — it matches one-line facts, not documents. Sharing the RAG
# model meant a second ~2.2GB copy in the worker. Changing this means dropping the
# otohom_semantic_memory table so mem0 recreates it at the new width.
MEM0_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
MEM0_EMBEDDING_DIMS=384

# ── Lead delivery / critical-escalation alerts ────────────────────────────
# One spreadsheet and one inbox for everything. Each row carries `kind` (LEAD / ESCALATION / SUPPORT
# / PARTIAL) so the team filters rather than looking in two places, and the escalation email prints
# the exact command for handing the thread back.
LEADS_WEBHOOK_URL=
LEADS_EMAIL_TO=sales@otohom.com
LEADS_EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# Colleagues who may control a handoff from WhatsApp, comma-separated. Any form works — "9812345678",
# "919812345678" and "+91 98123 45678" all match, because the last 10 digits are compared.
# A colleague works the customer on their OWN number, so nothing they say reaches this system:
# texting `#done <customer number> <what you did>` to the agent's number is how the hold is released
# and how the outcome gets into the agent's context. `#back` also tells the customer the agent is
# back; `#status` just reports. THIS LIST IS THE AUTHORISATION — a number not on it is treated as an
# ordinary customer, because anyone who learned the syntax could otherwise release any hold on any
# thread. Leave empty to disable the commands entirely.
STAFF_WHATSAPP_NUMBERS=

# Hours a person may hold a thread before the agent resumes on its own. Handback is human-driven by
# design; this is only a safety net so a forgotten release cannot strand a customer. 0 = require an
# explicit release, always.
HANDOFF_MAX_HOLD_HOURS=24

# ── RAG pipeline ──────────────────────────────────────────────────────────
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSIONS=1024
RAG_SIMILARITY_THRESHOLD=0.50
RAG_TOP_K_CHILDREN=20
RAG_TOP_K_FINAL=3
RAG_CHILD_CHUNK_SIZE=256
RAG_PARENT_CHUNK_SIZE=1024
RAG_CHUNK_OVERLAP=100

# Externally reachable base URL of this app — the same tunnel/domain Meta and Razorpay post
# their webhooks to, e.g. https://abc123.ngrok-free.app (no trailing slash). The brochure URL
# Meta downloads is derived from it, so this is the only value you need to set.
PUBLIC_BASE_URL=
# Optional override: point at a CDN copy instead of the PDF this app serves.
BROCHURE_URL=
BROCHURE_FILENAME=Otohom-Lookbook.pdf
# The PDF this app serves at /api/v1/brochure. The merchant's artwork is NOT in this repository, so
# supply your own file here (or set BROCHURE_URL above). With no file and no override the agent is
# told it has no brochure and must not offer one — better than promising a PDF that 404s.
BROCHURE_FILE_PATH=docs/brochure.pdf
